# Copy to .env and adjust. Every setting can also be passed as an environment variable.
LEDGER_ENVIRONMENT=development
LEDGER_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ledger

# Generate a real secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
LEDGER_JWT_SECRET=dev-only-secret-change-me-dev-only-secret
LEDGER_ACCESS_TOKEN_TTL_MINUTES=15

LEDGER_SUPPORTED_CURRENCIES=["USD","EUR","GBP","JPY"]
LEDGER_TRANSFER_FEE_BPS=0

LEDGER_RATE_LIMIT_CAPACITY=20
LEDGER_RATE_LIMIT_REFILL_PER_SECOND=5

LEDGER_LOG_LEVEL=INFO
LEDGER_LOG_JSON=false

# Optional: deliver ledger events to a webhook. Leave empty to log events instead.
LEDGER_WEBHOOK_URL=
LEDGER_WEBHOOK_SECRET=
